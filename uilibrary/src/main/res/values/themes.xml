<resources xmlns:tools="http://schemas.android.com/tools">

    <!--  material design 3 设计   -->
    <!--  主题颜色配置：https://www.figma.com/community/file/1035203688168086460 在figma中打开，右键选择插件配置主题   -->

    <style name="AppTheme" parent="AppTheme.NoStatusBar"></style>

    <style name="AppTheme.NoStatusBar" parent="AppTheme.Material3.Color.TextColor">
        <!--        edge to edge    -->
        <!-- 顶部状态栏  Status bar color. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- 底部操作栏  navigationBarColor-->
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Optional: set the status bar light and content dark. 设置状态栏文字色为深色, true为浅色背景深色文字, false为深色背景浅色文字-->
        <item name="android:windowLightStatusBar">true</item>
        <!-- Optional: set the navigation bar light and content dark. 设置状态栏文字色为深色, true为浅色背景深色文字, false为深色背景浅色文字-->
        <!--        <item name="android:windowLightNavigationBar">true</item>-->
        <!--android:background 与 android:windowBackground区别-->
        <!--android:windowBackground 一般用于activity启动的时候，默认的那个背景图。
            如果你不设置这个属性，那么你的应用启动的时候，会白屏一段时间。-->
        <!--android:background 就是控件的背景。比如设置textView的背景图。是个坑。
            android:background 属性会应用于你当前页面的所有的控件上。也会影响你的dialog的背景。你会发现，你的dialog 的title,message,button都有了背景-->
        <!--默认状态下页面的背景色-->
        <!--<item name="android:windowBackground">@color/color_page_bg</item>-->
        <!--控件的背景-->
        <!--<item name="android:background">@color/color_page</item>-->
        <item name="android:windowBackground">?attr/android:colorBackground</item>

        <!--        窗口（Activity）切换动画-->
        <item name="android:windowAnimationStyle">@style/default_animation</item>

        <!-- Secondary brand color. -->
        <item name="colorAccent">?attr/colorSecondary</item>
        <item name="colorSecondaryVariant">?attr/colorSecondaryVariant</item>

        <!--        <item name="enableEdgeToEdge">?attr/enableEdgeToEdge</item>-->
    </style>

    <!--    文字颜色    -->
    <style name="AppTheme.Material3.Color.TextColor" parent="AppTheme.Material3.Color.TextAppearance">
        <item name="appTextColorTitle">@color/m3_app_color_light_title</item>
        <item name="appTextColorSubTitle">@color/m3_app_color_light_title_sub</item>
        <item name="appTextColorBody">@color/m3_app_color_light_body</item>
        <item name="appTextColorLabel">@color/m3_app_color_light_label</item>
        <item name="appTextColorHint">@color/m3_app_color_light_hint</item>
        <item name="appTextColorDisable">@color/m3_app_color_light_disable</item>
    </style>

    <!-- 默认Activity跳转动画 -->
    <style name="default_animation" mce_bogus="1" parent="@android:style/Animation.Activity">
        <!--表示一个activity创建进入的效果。-->
        <item name="android:activityOpenEnterAnimation">@anim/activity_up_in</item>
        <!--一个activity还没有finish()下退出效果, 比如有俩个activity A与B 首先启动A 然后再启动B 那么A还没有finish()  这时A的退出效果。-->
        <item name="android:activityOpenExitAnimation">@anim/activity_up_out</item>
        <!-- 表示上一个activity返回进入效果 比如有俩个activity A与B  B在最上面，B退出(finish)后 A重新进入的效果。-->
        <item name="android:activityCloseEnterAnimation">@anim/activity_down_in</item>
        <!--表示的是activity finish()之后的效果 比如有俩个activity A与B B退出后会被finish() 那么B的退出效果在这定义。-->
        <item name="android:activityCloseExitAnimation">@anim/activity_down_out</item>
    </style>

    <style name="TranslucentDialog" parent="Theme.Material3.DayNight.Dialog">
        <!-- 背景颜色及透明程度 -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <!-- 是否半透明 -->
        <item name="android:windowIsTranslucent">false</item>
        <!-- 是否没有标题 -->
        <item name="android:windowNoTitle">true</item>
        <!-- 是否浮现在activity之上 -->
        <item name="android:windowIsFloating">true</item>
        <!-- 是否背景模糊 -->
        <item name="android:backgroundDimEnabled">false</item>
        <!-- 设置背景模糊的透明度-->
        <item name="android:backgroundDimAmount">0.5</item>
    </style>


</resources>